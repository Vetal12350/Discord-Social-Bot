# Discord Developer Portal bot token. NEVER commit or share it!
DISCORD_TOKEN=PASTE_YOUR_TOKEN_HERE
# DISCORD_BOT_TOKEN is also supported for existing installations; set only one.
# Optional: Discord server ID to sync slash commands instantly.
TEST_GUILD_ID=
# Optional: comma-separated channel IDs, empty = all channels bot can access.
ALLOWED_CHANNEL_IDS=
# Primary repost mode; requires Manage Webhooks, and Manage Messages for deletion.
REPOST_MODE=webhook
# Auto translate non-Russian posts into Russian (when available).
TRANSLATE_ENABLED=true
# Optional real contact email for MyMemory free translation quota:
# 5,000 chars/day without email, 50,000 chars/day with one (provider limits apply).
MYMEMORY_EMAIL=
